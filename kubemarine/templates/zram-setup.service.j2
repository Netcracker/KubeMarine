[Unit]
Description=Create zram mount for path {{ path }}
DefaultDependencies=no
Wants=systemd-modules-load.service
After=systemd-modules-load.service
After=systemd-remount-fs.service
After=local-fs-pre.target
Before=local-fs.target

[Service]
Type=oneshot
RemainAfterExit=yes
ExecCondition=/bin/bash -c '! zramctl -o MOUNTPOINT --noheadings | grep -x {{ path }}' 
ExecStart=/bin/bash -c 'sleep 1; mkdir -p {{ path }}; device=$(zramctl --find --size {{ size*1024*1024 }} --algorithm zstd); mkfs.ext4 -m 0 -O ^has_journal -F $device; mount $device {{ path }}'

[Install]
WantedBy=local-fs.target
